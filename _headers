/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin
  X-GlobalMarket-Release: 20261012-retail-sales-report-fresh-arrivals-v1
  X-GlobalMarket-Analytics-Release: 20261011-retail-full-recovery-v1

/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/app.js
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/data/site-config.json
  Cache-Control: no-store

/home-category-rail-v4.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/category-icons/*
  Cache-Control: public, max-age=31536000, immutable

/assets/google-consent.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/google-consent.js
  Cache-Control: public, max-age=0, must-revalidate
